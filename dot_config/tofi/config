#
### Fonts
#
	font = "/usr/share/fonts/OTF/CodeNewRomanNerdFont-Regular.otf"
	font-size = 16

#
### Text theming
#
	text-color = #fffcf2
	prompt-background = #252422
	input-background = #252422

	# Selection text
	selection-color = #eb5e28
	selection-background = #252422
	selection-match-color = #ccc5b9

#
### Text layout
#
	prompt-text = "Lancer : "
	result-spacing = 3

#
### Window theming
#
	width = 60%
	height = 80%
	background-color = #252422
	outline-width = 0
	border-width = 2
	border-color = #eb5e28
	corner-radius = 10
	clip-to-padding = true
	scale = true

#
### Behaviour
#
	hide-cursor = true
  matching-algorithm = fuzzy
	hidden-character = "*"
	drun-launch = true
